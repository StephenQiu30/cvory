# Business Service Ports
FRONTEND_PORT=3000
BACKEND_PORT=3001
WORKSPACE_PORT=1230

# Reuse Existing Host Infrastructure (PostgreSQL & Redis)
# Inside Docker containers use host.docker.internal; locally on host use 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://cvory:cvory_dev_password@host.docker.internal:5432/cvory
REDIS_URL=redis://host.docker.internal:6379/0

# Frontend Public & Internal Endpoints
FRONTEND_ORIGIN=http://127.0.0.1:3000
FRONTEND_INTERNAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api

# Stateless JWT (replace in staging/production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_DAYS=14

# Mail SMTP (NetEase 163 Mail)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@163.com
SMTP_PASS=your-163-client-auth-code
SMTP_FROM="简序 CVory <your-account@163.com>"

# S3-Compatible Object Storage (Aliyun OSS / MinIO / Cloudflare R2)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=cvory-avatars
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/cvory-avatars

# Playwright PDF Export Concurrency Limit
PDF_MAX_CONCURRENCY=2
