# ==============================================
# 简序 · CVory 环境变量配置模板
# 本文件可提交至 Git，真实凭据请填入 .env 中并保持本地忽略
# ==============================================

# 宿主机 MySQL 连接配置（用于 Docker 容器复用宿主机已启动的 MySQL）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=cvory

# 后端 FastAPI 服务配置
BACKEND_PORT=8000

# 前端 Next.js 服务配置
FRONTEND_PORT=3000
# 同站点浏览器访问来源，以及后端访问打印页面的受控地址
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_INTERNAL_URL=http://127.0.0.1:3000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
