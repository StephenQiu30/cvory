# ==============================================
# 简序 · CVory 环境变量配置模板
# 本文件可提交至 Git，真实凭据请填入 .env 中并保持本地忽略
# ==============================================

# 宿主机 MySQL 连接配置（用于 Docker 容器复用宿主机已启动的 MySQL）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=cvory

# 后端 FastAPI 服务配置
BACKEND_PORT=8000
DEV_MODE=True
OWNER_TOKEN=cvory-default-owner-secret

# 前端 Next.js 服务配置
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
