# Backend Runtime
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:3000

# PostgreSQL
DATABASE_URL=postgresql://cvory:cvory_dev_password@127.0.0.1:5432/cvory?schema=public

# Redis (JWT blacklist + OTP TTL & rate limits)
REDIS_URL=redis://127.0.0.1:6379

# Stateless JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=14d

# Mail SMTP (Dev: Mailpit 127.0.0.1:1025; Staging/Prod: NetEase 163 smtp.163.com:465)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="简序 CVory <no-reply@cvory.local>"
