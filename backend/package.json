{
  "name": "cvory-backend",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "pnpm build && pnpm start",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test --max-warnings=0",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "openapi": "pnpm build && node dist/openapi.js",
    "format:check": "prettier --check src test eslint.config.mjs",
    "format": "prettier --write src test eslint.config.mjs",
    "db:migrate:dev": "pnpm build && pnpm db:migrate"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "mammoth": "1.13.0",
    "mysql2": "3.24.6",
    "parse5": "8.1.1",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.64.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/yauzl": "2.10.3",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
