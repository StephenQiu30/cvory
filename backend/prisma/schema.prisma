generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Registered user identified by email (OTP login).
model User {
  id          String        @id @default(cuid())
  email       String        @unique
  createdAt   DateTime      @default(now())
  lastLoginAt DateTime?
  resumes     Resume[]
  claims      ResumeClaim[]
}

/// Resume metadata, ownership, and soft-delete tombstone.
/// Single current schema (no legacy migration files; synced via `prisma db push`).
model Resume {
  id              String              @id @default(cuid())
  userId          String
  title           String
  templateId      String
  contractVersion Int                 @default(1)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim           ResumeClaim?
  updates         ResumeYjsUpdate[]
  snapshot        ResumeYjsSnapshot?

  @@index([userId, deletedAt, updatedAt])
}

/// Guarantees idempotent single-draft claiming from guest local storage.
model ResumeClaim {
  id            String   @id @default(cuid())
  userId        String
  clientDraftId String
  resumeId      String   @unique
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume        Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([userId, clientDraftId])
}

/// Append-only Yjs binary updates persisted inside PostgreSQL transactions before ACK.
model ResumeYjsUpdate {
  id         BigInt   @id @default(autoincrement())
  resumeId   String
  clientSeq  Int
  updateData Bytes
  createdAt  DateTime @default(now())
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, id])
}

/// Periodic compacted Yjs state snapshot for fast reload.
model ResumeYjsSnapshot {
  resumeId     String   @id
  stateVector  Bytes
  snapshotData Bytes
  updatedAt    DateTime @updatedAt
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}
